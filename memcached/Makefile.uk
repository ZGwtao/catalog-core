$(eval $(call addlib_s,libevent_memcached,$(CONFIG_APPMEMCACHED)))
$(eval $(call addlib_s,appmemcached,$(CONFIG_APPMEMCACHED)))

LIBEVENT_MEMCACHED_VERSION := 2.1.12-stable
LIBEVENT_MEMCACHED_URL := https://github.com/libevent/libevent/releases/download/release-$(LIBEVENT_MEMCACHED_VERSION)/libevent-$(LIBEVENT_MEMCACHED_VERSION).tar.gz
LIBEVENT_MEMCACHED_BASENAME := libevent-$(LIBEVENT_MEMCACHED_VERSION)
$(eval $(call fetch,libevent_memcached,$(LIBEVENT_MEMCACHED_URL)))
$(eval $(call patch,libevent_memcached,$(LIBEVENT_MEMCACHED_BASE)/patches/libevent,$(LIBEVENT_MEMCACHED_BASENAME)))

APPMEMCACHED_VERSION := 1.6.39
APPMEMCACHED_URL := https://memcached.org/files/memcached-$(APPMEMCACHED_VERSION).tar.gz
APPMEMCACHED_BASENAME := memcached-$(APPMEMCACHED_VERSION)
$(eval $(call fetch,appmemcached,$(APPMEMCACHED_URL)))

LIBEVENT_MEMCACHED_SRC := $(LIBEVENT_MEMCACHED_ORIGIN)/$(LIBEVENT_MEMCACHED_BASENAME)
APPMEMCACHED_SRC := $(APPMEMCACHED_ORIGIN)/$(APPMEMCACHED_BASENAME)

CINCLUDES-y += -I$(LIBEVENT_MEMCACHED_SRC)/include
CINCLUDES-y += -I$(APPMEMCACHED_BASE)/include
LIBEVENT_MEMCACHED_CINCLUDES-y += -I$(LIBEVENT_MEMCACHED_SRC)/compat
LIBEVENT_MEMCACHED_CINCLUDES-y += -I$(LIBEVENT_MEMCACHED_SRC)
APPMEMCACHED_CINCLUDES-y += -I$(APPMEMCACHED_SRC)

LIBEVENT_MEMCACHED_CFLAGS-y += -Wno-unused-parameter -Wno-sign-compare
LIBEVENT_MEMCACHED_CFLAGS-y += -Deventfd=uk_sys_eventfd
LIBEVENT_MEMCACHED_CFLAGS-y += -include $(APPMEMCACHED_BASE)/include/uk-eventfd-compat.h
APPMEMCACHED_CFLAGS-y += -DNDEBUG -DHAVE_CONFIG_H -DXXH_VECTOR=0
APPMEMCACHED_CFLAGS-y += -U__ARM_NEON -U__ARM_NEON__
APPMEMCACHED_CFLAGS-y += -Wno-unused-parameter
APPMEMCACHED_MEMCACHED_FLAGS-y += -Dmain=memcached_main
APPMEMCACHED_MEMCACHED_FLAGS-y += -Dgetuid=memcached_getuid
APPMEMCACHED_MEMCACHED_FLAGS-y += -Dgeteuid=memcached_geteuid

LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/buffer.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/bufferevent.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/bufferevent_filter.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/bufferevent_pair.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/bufferevent_ratelim.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/bufferevent_sock.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/event.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/evmap.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/evthread.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/evthread_pthread.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/evutil.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/evutil_rand.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/evutil_time.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/listener.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/log.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/select.c
LIBEVENT_MEMCACHED_SRCS-y += $(LIBEVENT_MEMCACHED_SRC)/signal.c

APPMEMCACHED_SRCS-y += $(APPMEMCACHED_BASE)/main.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/memcached.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/hash.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/jenkins_hash.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/murmur3_hash.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/slabs.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/items.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/assoc.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/thread.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/daemon.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/stats_prefix.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/util.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/cache.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/bipbuffer.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/base64.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/logger.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/crawler.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/itoa_ljust.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/slab_automove.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/slabs_mover.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/authfile.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/restart.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/proto_text.c
APPMEMCACHED_SRCS-y += $(APPMEMCACHED_SRC)/proto_bin.c
